{
  "name": "markdown-explainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "tsx src/prepare-content.ts",
    "dev": "npm run prepare && vite",
    "build": "npm run prepare && vite build",
    "test": "tsx --test tests/*.test.ts",
    "check:e2e": "npx playwright install chromium && node e2e/check-markdown-explainer.mjs",
    "check": "npm run test && npm run build && npm run check:e2e"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-html": "^9.0.4",
    "remark-directive": "^3.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@playwright/test": "1.55.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
